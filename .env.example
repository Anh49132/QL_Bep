# Ví dụ PowerShell: $env:URLS = "http://localhost:5101"
# File này không tự được dotnet run nạp. Mỗi tiến trình web dùng một URL riêng.
# Order.Api: http://localhost:5101
# Notification.Service: http://localhost:5102
# Restaurant.Web: http://localhost:5103
# Các khóa cấu hình có thể ghi đè bằng biến môi trường:
Services__OrderApiUrl=http://localhost:5101
Services__NotificationUrl=http://localhost:5102

# Docker Compose đọc .env; dotnet run không tự đọc file này.
POSTGRES_DB=bepnha
POSTGRES_USER=bepnha
POSTGRES_PASSWORD=replace_with_local_password
POSTGRES_PORT=5432
# API chạy trên host; khi container hóa API, đổi Host=postgres;Port=5432.
ConnectionStrings__RestaurantDb=Host=localhost;Port=5432;Database=bepnha;Username=bepnha;Password=replace_with_local_password
